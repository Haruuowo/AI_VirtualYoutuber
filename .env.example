# ============================================================
# LUNA AI VTUBER - ENVIRONMENT CONFIGURATION
# ============================================================
# For the Interview Browser Demo (`start_demo.bat`), ONLY
# GROQ_API_KEY is needed (or local Ollama running).
# ============================================================

# 1. AI Brain ('groq' for fast cloud, or 'ollama' for local)
AI_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b
OLLAMA_MODEL=dolphin-llama3:8b

# 2. Voice / TTS ('edge' is free & zero-config, or 'elevenlabs')
TTS_ENGINE=edge
EDGE_VOICE=en-US-AnaNeural
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
AUDIO_DEVICE=

# 3. Full Stream Mode (Optional - only needed for `python main.py`)
TWITCH_TOKEN=
TWITCH_CHANNEL=
TIKTOK_USERNAME=

# 4. Minecraft Autonomous Bot (Optional)
MINECRAFT_ENABLED=false
MC_HOST=localhost
MC_PORT=25565
MC_USERNAME=Luna
MC_VERSION=1.20.1

