# ── LLM Provider ──────────────────────────────────────────────
# Which provider to use: groq | deepseek | openrouter
LLM_PROVIDER=groq
# Override the provider's default model (leave blank to use default)
LLM_MODEL=

# Provider API keys (only the one matching LLM_PROVIDER is required)
GROQ_API_KEY=your_key_here
OPENROUTER_API_KEY=your_key_here
DEEPSEEK_API_KEY=your_key_here

# ── TTS Engine ────────────────────────────────────────────────
# Which engine to use: edge | elevenlabs | gptsovits | qwen3tts
TTS_ENGINE=edge

# ElevenLabs (TTS_ENGINE=elevenlabs)
ELEVENLABS_API_KEY=your_key_here
ELEVENLABS_VOICE_ID=your_voice_id_here

# Edge-TTS (TTS_ENGINE=edge, default engine)
EDGE_VOICE=en-US-AriaNeural

# GPT-SoVITS (TTS_ENGINE=gptsovits, served at localhost:9880)
REF_AUDIO_PATH=

# Qwen3-TTS (TTS_ENGINE=qwen3tts, served at localhost:8880)
QWEN_TTS_URL=http://localhost:8880
QWEN_TTS_VOICE=Ryan
QWEN_TTS_LANGUAGE=English
# Voice cloning (optional — leave blank to use preset voice)
QWEN_TTS_REF_AUDIO=
QWEN_TTS_REF_TEXT=

# ── Japanese Mode ─────────────────────────────────────────────
# Set to true so Luna replies with {"en":"...","ja":"..."} and
# the Japanese text is spoken via TTS while English is displayed.
JAPANESE_MODE=false

# ── Audio Output ──────────────────────────────────────────────
# sounddevice device name fragment (leave blank for system default)
AUDIO_DEVICE=

# ── Twitch ────────────────────────────────────────────────────
TWITCH_TOKEN=your_twitch_oauth_token_here
TWITCH_CHANNEL=your_twitch_channel_here

# ── TikTok ────────────────────────────────────────────────────
TIKTOK_USERNAME=your_tiktok_username_here

# ── Minecraft ────────────────────────────────────────────────
# Enable the autonomous Minecraft brain loop
MINECRAFT_ENABLED=false
MC_HOST=your-server.aternos.me
MC_PORT=25565
MC_USERNAME=Luna
MC_VERSION=1.20.1